<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <!-- add our i18n resource -->
    <resource type="i18n" name="i18n" location="paperless-forms-plugin"/>
    
    <!-- add our web resources -->
    <web-resource key="paperless-forms-plugin-resources" name="paperless-forms-plugin Web Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        
        <resource type="download" name="paperless-forms-plugin.js" location="/js/paperless-forms-plugin.js"/>
        <resource type="download" name="paperless-forms-plugin.css" location="/css/paperless-forms-plugin.css"/>
        <resource type="download" name="images/" location="/images"/>

        <context>paperless-forms-plugin</context>
    </web-resource>
    
    <rest key="paperless-forms-rest" path="/paperless" version="1.0">
        <description>Provides REST API for Paperless Forms.</description>
        <package>com.paperless.forms.rest</package>
    </rest>
    
    <servlet key="paperless-forms-servlet" class="com.paperless.forms.servlet.PortalServlet">
        <url-pattern>/paperless-forms/portal</url-pattern>
        <url-pattern>/paperless-forms/inspection</url-pattern>
    </servlet>

    <web-item key="paperless-forms-menu-item" name="Paperless Forms" section="system.top.navigation.bar" weight="100">
        <description>Paperless Forms Portal</description>
        <label key="paperless-forms.menu.label"/>
        <link linkId="paperless-forms-link">/plugins/servlet/paperless-forms/portal</link>
    </web-item>
    
</atlassian-plugin>