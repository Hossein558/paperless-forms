@page "/reports"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using PaperlessForms.Core.Interfaces
@using PaperlessForms.Core.Models
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@inject IInspectionRepository InspectionRepo
@inject IPartRepository PartRepo
@inject NavigationManager NavManager

<PageTitle>گزارش‌گیری تفکیکی بازرسی (Syncfusion) - Paperless Forms</PageTitle>

<div class="reports-page">
    <!-- ─── هدر بخش گزارش‌ها ─── -->
    <div class="reports-header">
        <div class="header-title-group">
            <span class="header-icon">📊</span>
            <div>
                <h2>گزارش‌گیری تفکیکی و تحلیلی بازرسی</h2>
                <p class="text-muted">مشاهده، فیلتر و خروجی جامع داده‌های بازرسی با تفکیک کامل اندازه‌گیری‌ها و نمونه‌ها</p>
            </div>
        </div>
        <div class="header-actions">
            <a href="@GetExportUrl()" target="_blank" class="btn-export-excel">
                <span class="icon">📥</span> دریافت خروجی اکسل تفکیکی (.xlsx)
            </a>
        </div>
    </div>

    <!-- ─── نوار فیلترها (شامل تاریخ‌های شمسی) ─── -->
    <div class="filter-card">
        <div class="filter-grid">
            <div class="filter-item">
                <label>کد قطعه:</label>
                <input type="text" 
                       class="form-control-rtl" 
                       placeholder="مثال: FJ50659401" 
                       @bind="_filter.PartCode" 
                       @bind:event="oninput" 
                       @onkeydown="HandleKeyDown" />
            </div>

            <div class="filter-item">
                <label>نام یا کد بازرس:</label>
                <input type="text" 
                       class="form-control-rtl" 
                       placeholder="جستجوی نام بازرس..." 
                       @bind="_filter.InspectorName" 
                       @bind:event="oninput" 
                       @onkeydown="HandleKeyDown" />
            </div>

            <div class="filter-item">
                <label>آیتم کنترلی / مشخصه:</label>
                <input type="text" 
                       class="form-control-rtl" 
                       placeholder="مثال: ابعاد، وزن، ظاهر..." 
                       @bind="_filter.ParameterName" 
                       @bind:event="oninput" 
                       @onkeydown="HandleKeyDown" />
            </div>

            <div class="filter-item">
                <label>وضعیت انطباق:</label>
                <select class="form-control-rtl" @bind="_validitySelection">
                    <option value="all">همه نتایج (OK و NOK)</option>
                    <option value="ok">فقط موارد منطبق (OK)</option>
                    <option value="nok">فقط عدم‌انطباق‌ها (NOK)</option>
                </select>
            </div>

            <div class="filter-item">
                <PersianDatePicker Label="از تاریخ (شمسی):" 
                                   Placeholder="انتخاب تاریخ شروع..." 
                                   @bind-Value="_shamsiFromDate" />
            </div>

            <div class="filter-item">
                <PersianDatePicker Label="تا تاریخ (شمسی):" 
                                   Placeholder="انتخاب تاریخ پایان..." 
                                   @bind-Value="_shamsiToDate" />
            </div>
        </div>

        <!-- کلیدهای میانبر تاریخ شمسی -->
        <div class="date-presets">
            <span class="presets-label">انتخاب سریع بازه شمسی:</span>
            <button type="button" class="btn-preset" @onclick="() => SetDatePreset(0)">امروز</button>
            <button type="button" class="btn-preset" @onclick="() => SetDatePreset(7)">۷ روز گذشته</button>
            <button type="button" class="btn-preset" @onclick="() => SetDatePreset(30)">۳۰ روز گذشته</button>
            <button type="button" class="btn-preset" @onclick="() => SetDatePreset(90)">۳ ماه گذشته</button>
            <button type="button" class="btn-preset" @onclick="ClearDatePreset">همه تاریخ‌ها</button>
        </div>

        <div class="filter-actions">
            <button class="btn-primary-rtl" @onclick="LoadReportAsync" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span>در حال جستجو...</span>
                }
                else
                {
                    <span>🔍 اعمال فیلتر</span>
                }
            </button>
            <button class="btn-secondary-rtl" @onclick="ResetFiltersAsync" disabled="@_isLoading">
                🔄 بازنشانی فرم
            </button>
        </div>
    </div>

    <!-- ─── کارت‌های شاخص‌های کیفی (KPI Cards) ─── -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon icon-blue">📋</div>
            <div class="kpi-details">
                <span class="kpi-value">@_totalSubmissions</span>
                <span class="kpi-label">تعداد کل فرم‌ها</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon icon-cyan">🔢</div>
            <div class="kpi-details">
                <span class="kpi-value">@_totalRecords</span>
                <span class="kpi-label">ردیف‌های ارزیابی‌شده</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon icon-green">✅</div>
            <div class="kpi-details">
                <span class="kpi-value text-success">@_okCount</span>
                <span class="kpi-label">موارد منطبق (OK)</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon icon-red">⚠️</div>
            <div class="kpi-details">
                <span class="kpi-value text-danger">@_nokCount</span>
                <span class="kpi-label">عدم‌انطباق‌ها (NOK)</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon icon-purple">📈</div>
            <div class="kpi-details">
                <span class="kpi-value">@_qualityYield.ToString("F1")%</span>
                <span class="kpi-label">نرخ انطباق کیفی</span>
            </div>
        </div>
    </div>

    <!-- ─── گرید پیشرفته Syncfusion ─── -->
    <div class="report-table-container">
        <div class="table-toolbar">
            <span class="records-badge">
                تعداد رکوردهای یافت‌شده در گرید: <strong>@_records.Count</strong> سطر تفکیک‌شده
            </span>
            <span class="grid-hint">
                💡 با کلیک روی عناوین ستون‌ها می‌توانید مرتب‌سازی (Sort) یا فیلتر اختصاصی انجام دهید.
            </span>
        </div>

        @if (_isLoading)
        {
            <div class="loading-box">
                <div class="spinner"></div>
                <p>در حال واکشی و تفکیک اطلاعات بازرسی...</p>
            </div>
        }
        else if (_records.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">📭</span>
                <h3>هیچ رکوردی یافت نشد</h3>
                <p>با فیلترهای مشخص‌شده داده‌ای در سیستم موجود نیست.</p>
            </div>
        }
        else
        {
            <div class="syncfusion-grid-wrapper">
                <SfGrid DataSource="@_records"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowResizing="true"
                        AllowTextWrap="true"
                        EnableRtl="true"
                        CssClass="custom-sf-grid">
                    <GridPageSettings PageSize="15" PageSizes="@(new int[] { 10, 15, 25, 50, 100 })" />
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                    <GridTextWrapSettings WrapMode="WrapMode.Content" />
                    <GridColumns>
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.RowNumber)" HeaderText="ردیف" Width="70" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.SubmittedAtShamsi)" HeaderText="تاریخ ثبت (شمسی)" Width="160" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.PartCode)" HeaderText="کد قطعه" Width="130" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.PartName)" HeaderText="نام قطعه" Width="180" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.InspectorName)" HeaderText="بازرس" Width="130" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.ParameterName)" HeaderText="مشخصه کنترلی" Width="160" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.AcceptanceCriteria)" HeaderText="معیار پذیرش" Width="200" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.ControlMethod)" HeaderText="روش کنترل" Width="120" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.MinValue)" HeaderText="حد پایین" Width="90" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.MaxValue)" HeaderText="حد بالا" Width="90" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.Sample1)" HeaderText="نمونه ۱" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.Sample2)" HeaderText="نمونه ۲" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.Sample3)" HeaderText="نمونه ۳" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.Sample4)" HeaderText="نمونه ۴" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.Sample5)" HeaderText="نمونه ۵" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.SampleMin)" HeaderText="کمینه" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.SampleMax)" HeaderText="بیشینه" Width="85" TextAlign="TextAlign.Center" Format="G4" />
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.JobSetupOk)" HeaderText="Job Setup" Width="95" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var item = (DecomposedInspectionRecord)context;
                                    <span>@(item.JobSetupOk.HasValue ? (item.JobSetupOk.Value ? "OK" : "NOK") : "-")</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(DecomposedInspectionRecord.ResultStatus)" HeaderText="نتیجه انطباق" Width="120" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var item = (DecomposedInspectionRecord)context;
                                }
                                <span class="badge @(item.IsValid ? "badge-ok" : "badge-nok")">
                                    @(item.IsValid ? "منطبق (OK)" : "نامنطبق (NOK)")
                                </span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }
    </div>
</div>

@code {
    private readonly InspectionReportFilter _filter = new();
    private string _validitySelection = "all";
    private string _shamsiFromDate = string.Empty;
    private string _shamsiToDate = string.Empty;
    private List<DecomposedInspectionRecord> _records = new();
    private bool _isLoading = true;

    private int _totalSubmissions = 0;
    private int _totalRecords = 0;
    private int _okCount = 0;
    private int _nokCount = 0;
    private double _qualityYield = 0.0;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        StateHasChanged();

        if (_validitySelection == "ok") _filter.IsValid = true;
        else if (_validitySelection == "nok") _filter.IsValid = false;
        else _filter.IsValid = null;

        _filter.FromDate = PersianDateHelper.ToGregorian(_shamsiFromDate);
        var toDateG = PersianDateHelper.ToGregorian(_shamsiToDate);
        _filter.ToDate = toDateG.HasValue ? toDateG.Value.AddDays(1).AddSeconds(-1) : null;

        _records = await InspectionRepo.GetDecomposedSubmissionsAsync(_filter);

        _totalRecords = _records.Count;
        _totalSubmissions = _records.Select(r => r.SubmissionId).Distinct().Count();
        _okCount = _records.Count(r => r.IsValid);
        _nokCount = _records.Count(r => !r.IsValid);
        _qualityYield = _totalRecords > 0 ? ((double)_okCount / _totalRecords) * 100.0 : 100.0;

        _isLoading = false;
    }

    private void SetDatePreset(int daysAgo)
    {
        var now = DateTime.Now;
        if (daysAgo == 0)
        {
            _shamsiFromDate = PersianDateHelper.ToShamsi(now);
            _shamsiToDate = PersianDateHelper.ToShamsi(now);
        }
        else
        {
            _shamsiFromDate = PersianDateHelper.ToShamsi(now.AddDays(-daysAgo));
            _shamsiToDate = PersianDateHelper.ToShamsi(now);
        }
    }

    private void ClearDatePreset()
    {
        _shamsiFromDate = string.Empty;
        _shamsiToDate = string.Empty;
    }

    private async Task ResetFiltersAsync()
    {
        _filter.PartCode = null;
        _filter.InspectorName = null;
        _filter.ParameterName = null;
        _filter.MachineCode = null;
        _filter.FromDate = null;
        _filter.ToDate = null;
        _filter.IsValid = null;
        _validitySelection = "all";
        _shamsiFromDate = string.Empty;
        _shamsiToDate = string.Empty;

        await LoadReportAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadReportAsync();
        }
    }

    private string GetExportUrl()
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(_filter.PartCode)) qs.Add($"partCode={Uri.EscapeDataString(_filter.PartCode)}");
        if (!string.IsNullOrWhiteSpace(_filter.InspectorName)) qs.Add($"inspector={Uri.EscapeDataString(_filter.InspectorName)}");
        if (!string.IsNullOrWhiteSpace(_filter.ParameterName)) qs.Add($"parameter={Uri.EscapeDataString(_filter.ParameterName)}");
        if (_filter.FromDate.HasValue) qs.Add($"from={_filter.FromDate.Value:yyyy-MM-dd}");
        if (_filter.ToDate.HasValue) qs.Add($"to={_filter.ToDate.Value:yyyy-MM-dd}");
        if (_filter.IsValid.HasValue) qs.Add($"isValid={_filter.IsValid.Value}");

        var query = qs.Count > 0 ? "?" + string.Join("&", qs) : "";
        return $"api/reports/export/excel{query}";
    }
}
