@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="app-title">
                <span class="app-icon">🏭</span>
                <span>سیستم Paperless Manufacturing</span>
            </div>
            <div class="user-info">
                <span>کروز - واحد کنترل کیفیت</span>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    خطایی رخ داد. لطفاً صفحه را مجدداً بارگذاری کنید.
    <a href="." class="reload">بارگذاری مجدد</a>
    <button class="dismiss">✕</button>
</div>
