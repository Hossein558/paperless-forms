@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="top-row-right">
                <div class="app-title">
                    <span class="app-icon">🏭</span>
                    <span>سیستم Paperless Manufacturing</span>
                </div>
                <div class="top-nav-links">
                    <a class="top-nav-link" href="">🏠 داشبورد</a>
                    <a class="top-nav-link" href="inspection/in-process">🔍 فرم بازرسی</a>
                    <a class="top-nav-link highlight-link" href="reports">📊 گزارش‌ها و خروجی اکسل</a>
                </div>
            </div>
            <div class="user-info">
                <span>کروز - واحد کنترل کیفیت</span>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer">
            <span>Atlassian Paperless Forms Software (v1.0.0#sha1:crouse:@_nodeId) · <a href="/paperless/">About</a></span>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    خطایی رخ داد. لطفاً صفحه را مجدداً بارگذاری کنید.
    <a href="." class="reload">بارگذاری مجدد</a>
    <button class="dismiss">✕</button>
</div>

@code {
    private string _nodeId = string.Empty;

    protected override void OnInitialized()
    {
        var envNode = Environment.GetEnvironmentVariable("NODE_ID");
        if (!string.IsNullOrEmpty(envNode))
        {
            _nodeId = envNode;
        }
        else
        {
            var host = System.Net.Dns.GetHostName();
            _nodeId = host.Contains("42") || host.Contains("node1") ? "node1" : (host.Contains("43") || host.Contains("node2") ? "node2" : host);
        }
    }
}
